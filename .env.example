# Concave Support Ticketing System Environment Variables
APP_NAME="Concave Support Ticketing System"
ENVIRONMENT="development"
DEBUG=true

# Database (SQLite default)
DATABASE_URL="sqlite:///./concave_tickets.db"

# Security & Authentication
SECRET_KEY="concave-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default SLA Policies (hours)
DEFAULT_TAT_HIGH=4
DEFAULT_TAT_MEDIUM=24
DEFAULT_TAT_LOW=48

# Default System Policies
DEFAULT_REOPEN_WINDOW_DAYS=7
DEFAULT_MAX_REOPEN_ATTEMPTS=2
DEFAULT_AUTO_CLOSE_DAYS=7
